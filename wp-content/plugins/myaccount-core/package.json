{
  "name": "myaccount-core-build",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "cross-env NODE_ENV=development node ./scripts/build-css.js",
    "build:css:min": "cross-env NODE_ENV=production node ./scripts/build-css.js",
    "watch:css": "cross-env NODE_ENV=development node ./scripts/build-css.js --watch",
    "build:js": "esbuild ./assets/src/js/alpine/init.js --bundle --outfile=./assets/js/alpine.bundle.js --format=iife --global-name=AlpineBundle",
    "build:js:min": "esbuild ./assets/src/js/alpine/init.js --bundle --outfile=./assets/js/alpine.bundle.min.js --format=iife --global-name=AlpineBundle --minify",
    "watch:js": "esbuild ./assets/src/js/alpine/init.js --bundle --outfile=./assets/js/alpine.bundle.js --format=iife --global-name=AlpineBundle --watch",
    "build": "npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.17",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.9",
    "postcss": "^8.4.33",
    "postcss-import": "^14.0.0",
    "postcss-nested": "^7.0.2",
    "postcss-nested-ancestors": "^2.0.0"
  },
  "dependencies": {
    "alpinejs": "^3.14.0",
    "lodash": "^4.17.21",
    "yup": "^1.3.3"
  }
}
